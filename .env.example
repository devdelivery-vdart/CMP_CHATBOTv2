# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file anywhere or share it.

# ---- Database (the restricted read-only MySQL user we created) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_readonly
DB_PASSWORD=ChangeThisPassword123!
DB_NAME=staffing_db

# ---- LLM providers ----
# Groq (Llama 3.3) - used FIRST, since it's free/cheap for testing
GROQ_API_KEY=your_groq_key_here

# OpenAI - used as FALLBACK only, if Groq fails or gives unusable SQL
OPENAI_API_KEY=your_openai_key_here
